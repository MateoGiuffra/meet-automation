# meet-automation - Configuración
# Copiar este archivo a .env y completar los valores.

# Zona horaria explícita (para que no dependa de la config de la PC)
# Ver lista: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Argentina/Buenos_Aires

# ── Meeting ──────────────────────────────────────────────
# URL completa del Google Meet a joinear
MEET_URL=https://meet.google.com/abc-defg-hij

# Nombre que se muestra en Meet (se sanitiza si es necesario)
MEET_DISPLAY_NAME=Profesor

# ── Ventana horaria ──────────────────────────────────────
# Formato HH:mm (hora local de la PC)
WINDOW_START_TIME=10:00
WINDOW_END_TIME=12:00

# ── Chrome ───────────────────────────────────────────────
# Path al ejecutable de Chrome en tu PC
# Windows típico:
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Path al directorio clonado del profile de Chrome
# Ver README.md para instrucciones de cómo clonarlo
CHROME_USER_DATA_DIR=C:\chrome-profile-clone

# ── Browser ──────────────────────────────────────────────
# Tamaño de la ventana del browser (pixeles)
BROWSER_WIDTH=1280
BROWSER_HEIGHT=720

# ── Join ─────────────────────────────────────────────────
# Cuántos minutos esperar en el lobby antes de declarar timeout
LOBBY_TIMEOUT_MINUTES=5

# Cantidad de reintentos para clickear "Ask to join"
MAX_JOIN_ATTEMPTS=3

# Pausa entre reintentos de join (milisegundos)
RETRY_WAIT_MS=15000

# ── Debug ────────────────────────────────────────────────
# Directorio donde se guardan screenshots de falla
DEBUG_SCREENSHOTS_DIR=./debug-screenshots

# ── LLM (Etapa 2) ────────────────────────────────────────
# Provider del LLM: "claude-cli" (wrapper de claude) u "opencode-cli"
# (wrapper de opencode). Ambos corren los CLIs de forma no interactiva.
LLM_PROVIDER=claude-cli

# Modelo por defecto (alias de claude: sonnet/opus/haiku; para opencode
# usar formato "provider/model", ej. "anthropic/claude-sonnet-4-5")
LLM_DEFAULT_MODEL=sonnet

# Lista opcional de modelos a mostrar en getModels(). Si se deja vacío,
# cada provider usa su lista interna (opencode-cli intenta listar en vivo).
LLM_MODELS=

# Override del binario si no está en PATH (path completo)
LLM_CLAUDE_BIN=
LLM_OPENCODE_BIN=

# Timeout por invocación del CLI (ms)
LLM_TIMEOUT_MS=120000

# ── Monitor de fin de clase (Etapa 2) ────────────────────
# Nombre (o substring) del profe, para detectar su presencia en el panel People
PROFESSOR_NAME=

# Cada cuánto se sondea el conteo de participantes (ms) — no invasivo
PARTICIPANT_POLL_INTERVAL_MS=5000

# Caída de participantes que dispara el trigger (lo que ocurra primero)
PARTICIPANT_DROP_PCT=30
PARTICIPANT_DROP_ABSOLUTE=4
PARTICIPANT_DROP_WINDOW_MS=120000

# Cada cuánto se chequea presencia del profe (ms) — abre/cierra el panel People
PROFESSOR_CHECK_INTERVAL_MS=15000
# Ausencia continua del profe antes de preguntarle al LLM (ms)
PROFESSOR_ABSENCE_GRACE_MS=20000

# Mínimo tiempo entre invocaciones al LLM juez (ms) — rate limit
JUDGE_MIN_INTERVAL_MS=60000
# Minutos de contexto (chat/captions) que se le pasan al juez
JUDGE_CONTEXT_WINDOW_MINUTES=10

# Directorio donde se guardan los JSON de sesión
SESSIONS_DIR=./logs/sessions
